@model CallToActionModel
<section class="cta" aria-labelledby="cta-title">
    <img class="cta__img" src="@ImageHelper.Sized(Model.ImagePath ?? SiteImages.CallToAction, 2000)"
         srcset="@ImageHelper.SrcSet(Model.ImagePath ?? SiteImages.CallToAction, 800, 1400, 2000)" sizes="100vw"
         alt="" loading="lazy" decoding="async" />
    <div class="cta__overlay"></div>
    <div class="container-xl cta__content text-center" data-reveal>
        <span class="eyebrow eyebrow--light">Begin Your Journey</span>
        <h2 class="cta__title" id="cta-title">@Model.Title</h2>
        <p class="cta__text">@Model.Text</p>
        <a class="btn btn-gold btn-lg-lux" href="@Model.ButtonUrl">@Model.ButtonText</a>
    </div>
</section>
