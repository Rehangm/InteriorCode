@inject CompanySettings Company
<footer class="site-footer" aria-labelledby="footer-heading">
    <h2 id="footer-heading" class="visually-hidden">Footer</h2>
    <div class="container-xl">
        <div class="row g-5">
            <div class="col-lg-4 col-md-6">
                <a class="brand brand--footer" href="/" aria-label="@Company.Name – Home">
                    <span class="brand-mark">IDS</span>
                    <span class="brand-text">
                        <span class="brand-name">Interior Design</span>
                        <span class="brand-sub">Studio</span>
                    </span>
                </a>
                <p class="footer-about">
                    A luxury interior design practice creating timeless residential and commercial spaces through
                    thoughtful design, honest materials and exceptional craftsmanship.
                </p>
                <ul class="social-links" aria-label="Social media">
                    <li><a href="@Company.Social.Instagram" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a></li>
                    <li><a href="@Company.Social.Facebook" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a></li>
                    <li><a href="@Company.Social.Pinterest" target="_blank" rel="noopener" aria-label="Pinterest"><i class="fa-brands fa-pinterest-p"></i></a></li>
                    <li><a href="@Company.Social.LinkedIn" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a></li>
                    <li><a href="@Company.Social.Houzz" target="_blank" rel="noopener" aria-label="Houzz"><i class="fa-brands fa-houzz"></i></a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-6 col-6">
                <h3 class="footer-title">Quick Links</h3>
                <ul class="footer-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/services">Services</a></li>
                    <li><a href="/projects">Projects</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/contact?enquiry=quote#enquiry-form">Get a Quote</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6 col-6">
                <h3 class="footer-title">Services</h3>
                @await Component.InvokeAsync("FooterServices")
            </div>

            <div class="col-lg-3 col-md-6">
                <h3 class="footer-title">Contact</h3>
                <ul class="footer-contact">
                    <li><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>@Company.FullAddress</span></li>
                    <li><i class="fa-solid fa-phone" aria-hidden="true"></i><a href="@Company.PhoneHref">@Company.Phone</a></li>
                    <li><i class="fa-regular fa-envelope" aria-hidden="true"></i><a href="mailto:@Company.Email">@Company.Email</a></li>
                    <li><i class="fa-regular fa-clock" aria-hidden="true"></i><span>@Company.BusinessHoursWeekdays</span></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year @Company.Name. All rights reserved.</p>
            <p class="footer-bottom__links">
                <a href="/sitemap.xml">Sitemap</a>
                <span aria-hidden="true">·</span>
                <a href="#main-content" class="js-scroll-top">Back to top</a>
            </p>
        </div>
    </div>
</footer>
